COMPOSE_PROJECT_NAME=viewer
TZ=Asia/Tomsk
REPORTS_DIR=/app/reports
YANDEX_BUCKET=agent-dicom
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_REGION=ru-central1
XA_ARCHIVE_DELETE_PACS=false
XA_ARCHIVE_DELETE_LOCAL=false
REPORT_AGENT_ID=2
REMOTE_PACS_URL=http://pacs:8042/instances
REMOTE_PACS_USERNAME=mapdr
REMOTE_PACS_PASSWORD=changestrongpassword
REMOTE_PACS_TIMEOUT_SECONDS=300

# Для внутреннего сервера укажите его статический адрес в больничной сети.
# 0.0.0.0 публикует сервисы на всех сетевых интерфейсах.
BIND_ADDRESS=0.0.0.0

# Use URL-safe characters here because these values are also used in DB_DSN.
POSTGRES_DB=viewer
POSTGRES_USER=viewer
POSTGRES_PASSWORD=viewer-local-password

BACKEND_PORT=8080
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
FRONTEND_PORT=5173
FRONTEND_HTTP_PORT=80
PACS_AUTHORIZATION=Basic bWFwZHI6Y2hhbmdlc3Ryb25ncGFzc3dvcmQ=

# Local build defaults. Replace with registry names on a deployment server.
BACKEND_IMAGE=idrisovmarat/viewer_backend:0.2.0
BACKEND_MIGRATIONS_IMAGE=idrisovmarat/viewer_backend-migrations:0.2.0
FRONTEND_IMAGE=idrisovmarat/viewer_frontend:0.2.0
IMAGE_VERSION=local
VCS_REF=unknown
