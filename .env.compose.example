COMPOSE_PROJECT_NAME=viewer
TZ=Asia/Tomsk
REPORTS_DIR=/app/reports
REMOTE_PACS_URL=http://pacs:8042/instances
REMOTE_PACS_USERNAME=mapdr
REMOTE_PACS_PASSWORD=changestrongpassword
REMOTE_PACS_TIMEOUT_SECONDS=300

# Для внутреннего сервера укажите его статический адрес в больничной сети.
# 0.0.0.0 публикует сервисы на всех сетевых интерфейсах.
BIND_ADDRESS=0.0.0.0

# Use URL-safe characters here because these values are also used in DB_DSN.
POSTGRES_DB=viewer
POSTGRES_USER=viewer
POSTGRES_PASSWORD=viewer-local-password

BACKEND_PORT=8080
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
OHIF_PORT=3000
FRONTEND_PORT=5173

# Local build defaults. Replace with registry names on a deployment server.
BACKEND_IMAGE=viewer-backend:local
BACKEND_MIGRATIONS_IMAGE=viewer-backend-migrations:local
FRONTEND_IMAGE=idrisovmarat/viewer_frontend:0.1.0
IMAGE_VERSION=local
VCS_REF=unknown
