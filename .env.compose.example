COMPOSE_PROJECT_NAME=viewer
TZ=Asia/Tomsk

# Use URL-safe characters here because these values are also used in DB_DSN.
POSTGRES_DB=viewer
POSTGRES_USER=viewer
POSTGRES_PASSWORD=viewer-local-password

BACKEND_PORT=8080
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
OHIF_PORT=3000

# Local build defaults. Replace with registry names on a deployment server.
BACKEND_IMAGE=viewer-backend:local
BACKEND_MIGRATIONS_IMAGE=viewer-backend-migrations:local
AGENT_IMAGE=hospital-agent:local
AGENT_BUILD_CONTEXT=../agent
IMAGE_VERSION=local
VCS_REF=unknown
AGENT_VCS_REF=unknown

# Required only for the send_study_to_yandex command.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
